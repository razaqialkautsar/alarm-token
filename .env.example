# Copy to .env and fill in. Never commit .env.
# Testnet only (CLAUDE.md section 2.4). No mainnet RPCs, keys, or addresses.

# Dedicated testnet-only deployer key. Never a wallet that holds mainnet funds.
PRIVATE_KEY=

# Public RPCs below returned the expected chain ID via `cast chain-id` on 23 Nov 2026.

# Reactive Lasna testnet, chain ID 5318007 (RPC listed in PRD.md section 20.1)
LASNA_RPC_URL=https://lasna-rpc.rnk.dev/

# Base Sepolia, chain ID 84532 (public endpoint, rate limited)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Chain X: Ethereum Sepolia (11155111) or Unichain Sepolia (1301), decided at gate G2
ETH_SEPOLIA_RPC_URL=
UNICHAIN_SEPOLIA_RPC_URL=
